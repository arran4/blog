# Editable D2 source. Linked node IDs correspond to article headings.
direction: down
classes: {
  human: { style: { fill: "#FFF0C8"; stroke: "#AE791B"; font-color: "#533A09" } }
  chat: { style: { fill: "#DCEEFF"; stroke: "#2874AD"; font-color: "#163D5E" } }
  jules: { style: { fill: "#DEF6E2"; stroke: "#348B51"; font-color: "#17522B" } }
  codex: { style: { fill: "#EDE3FC"; stroke: "#784BAF"; font-color: "#402469" } }
  system: { style: { fill: "#F1F3F5"; stroke: "#6C7785"; font-color: "#303D4C" } }
}

O01: "O01 · Select starting point" {
  class: human
  
  link: "./#node-o01"
  tooltip: "First release, major/minor improvement, bug, feature or automation"
}

O02: "O02 · Open workstream" {
  class: chat
  
  link: "./#node-o02"
  tooltip: "One chat per coherent workstream; several independent workstreams can run"
}

O03: "O03 · Research and plan" {
  class: chat
  
  link: "./#node-o03"
  tooltip: "Inspect repository, issues, PRs, release state"
}

O04: "O04 · Accept approach?" {
  class: human
  shape: diamond
  link: "./#node-o04"
  tooltip: "Collaborative clarification and consequential decisions"
}

O05: "O05 · Reconcile issues" {
  class: chat
  
  link: "./#node-o05"
  tooltip: "Deduplicate, propose issues for approval"
}

O06: "O06 · Select work unit" {
  class: chat
  
  link: "./#node-o06"
  tooltip: "One or related issues, sequence/stack"
}

O07: "O07 · Select implementation path" {
  class: chat
  shape: diamond
  link: "./#node-o07"
  tooltip: "Jules / Codex-Agy / administration"
}

O08: "O08 · Small coding increment" {
  class: jules
  
  link: "./#node-o08"
  tooltip: "Short focused chunks; not management administrator"
}

O09: "O09 · Larger coding increment" {
  class: codex
  
  link: "./#node-o09"
  tooltip: "Alternative chosen worker, not simultaneous on Jules branch"
}

O10: "O10 · Publish reviewable evidence" {
  class: system
  
  link: "./#node-o10"
  tooltip: "Commits, PRs, CI and issue linkage"
}

O11: "O11 · Review and correct" {
  class: chat
  
  link: "./#node-o11"
  tooltip: "Independent diff review, CI triage, PR metadata, feedback loops"
}

O12: "O12 · Approve merge?" {
  class: human
  shape: diamond
  link: "./#node-o12"
  tooltip: "Human review and merge decision"
}

O13: "O13 · Merge / release gate" {
  class: system
  
  link: "./#node-o13"
  tooltip: "Merges and releases are separate decisions"
}

O14: "O14 · Close out and continue" {
  class: chat
  
  link: "./#node-o14"
  tooltip: "Reconcile issues, report next priority"
}

O01 -> O02
O02 -> O03
O03 -> O04
O04 -> O03: "revise"
O04 -> O05: "accept"
O05 -> O06
O06 -> O07
O07 -> O08: "Jules"
O07 -> O09: "Codex / Agy"
O07 -> O11: "administration"
O08 -> O10
O09 -> O10
O10 -> O11
O11 -> O08: "Jules correction"
O11 -> O09: "authorised handoff"
O11 -> O12: "ready for human"
O12 -> O11: "changes"
O12 -> O13: "merge approved"
O13 -> O14
O14 -> O03: "next phase"
