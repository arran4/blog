# Editable D2 source. Linked node IDs correspond to article headings.
direction: right
classes: {
  human: { style: { fill: "#FFF0C8"; stroke: "#AE791B"; font-color: "#533A09" } }
  chat: { style: { fill: "#DCEEFF"; stroke: "#2874AD"; font-color: "#163D5E" } }
  jules: { style: { fill: "#DEF6E2"; stroke: "#348B51"; font-color: "#17522B" } }
  codex: { style: { fill: "#EDE3FC"; stroke: "#784BAF"; font-color: "#402469" } }
  system: { style: { fill: "#F1F3F5"; stroke: "#6C7785"; font-color: "#303D4C" } }
}

MI01: "MI01 · Minor improvement goal" {
  class: human
  
  link: "../#node-mi01"
  tooltip: "Specify additive user-visible outcome"
}

MI02: "MI02 · Inspect existing issues and behaviour" {
  class: chat
  
  link: "../#node-mi02"
  tooltip: "Prefer reuse over duplicate issues"
}

MI03: "MI03 · Scope accepted?" {
  class: human
  shape: diamond
  link: "../#node-mi03"
  tooltip: "Confirm boundaries when consequential"
}

MI04: "MI04 · Acceptance criteria and prompt" {
  class: chat
  
  link: "../#node-mi04"
  tooltip: "Plan a bounded implementation increment"
}

MI05: "MI05 · Worker selection" {
  class: chat
  shape: diamond
  link: "../#node-mi05"
  tooltip: "Choose one worker for this increment"
}

MI06: "MI06 · Implement small change" {
  class: jules
  
  link: "../#node-mi06"
  tooltip: "Narrow code and focused tests"
}

MI07: "MI07 · Implement alternative change" {
  class: codex
  
  link: "../#node-mi07"
  tooltip: "Complex or interactive alternative"
}

MI08: "MI08 · Review diff and CI" {
  class: chat
  
  link: "../#node-mi08"
  tooltip: "Classify failures and check issue completion"
}

MI09: "MI09 · Merge approved?" {
  class: human
  shape: diamond
  link: "../#node-mi09"
  tooltip: "Chat handles Ready status; human merges"
}

MI10: "MI10 · Release or defer?" {
  class: human
  shape: diamond
  link: "../#node-mi10"
  tooltip: "Potential minor release, not automatic"
}

MI01 -> MI02
MI02 -> MI03
MI03 -> MI02: "redefine"
MI03 -> MI04: "yes"
MI04 -> MI05
MI05 -> MI06: "Jules"
MI05 -> MI07: "Codex / Agy"
MI06 -> MI08
MI07 -> MI08
MI08 -> MI06: "fix with current worker"
MI08 -> MI09: "verified"
MI09 -> MI10: "merge approved"
MI10 -> MI02: "new work / defer"
