# Editable D2 source. Linked node IDs correspond to article headings.
direction: down
classes: {
  human: { style: { fill: "#FFF0C8"; stroke: "#AE791B"; font-color: "#533A09" } }
  chat: { style: { fill: "#DCEEFF"; stroke: "#2874AD"; font-color: "#163D5E" } }
  jules: { style: { fill: "#DEF6E2"; stroke: "#348B51"; font-color: "#17522B" } }
  codex: { style: { fill: "#EDE3FC"; stroke: "#784BAF"; font-color: "#402469" } }
  system: { style: { fill: "#F1F3F5"; stroke: "#6C7785"; font-color: "#303D4C" } }
}

BF01: "BF01 · Bug report or failing behaviour" {
  class: human
  
  link: "../#node-bf01"
  tooltip: "Human, third-party or test/monitoring report"
}

BF02: "BF02 · Reproduce and locate cause" {
  class: chat
  
  link: "../#node-bf02"
  tooltip: "Gather logs, versions, observed vs expected"
}

BF03: "BF03 · Check existing issue and regression scope" {
  class: chat
  
  link: "../#node-bf03"
  tooltip: "Maintain durable problem state"
}

BF04: "BF04 · Enough evidence to act?" {
  class: chat
  shape: diamond
  link: "../#node-bf04"
  tooltip: "Request more data instead of guessing"
}

BF05: "BF05 · Choose repair worker" {
  class: chat
  shape: diamond
  link: "../#node-bf05"
  tooltip: "Jules small fix or Codex/Agy deeper debugging"
}

BF06: "BF06 · Implement regression fix" {
  class: jules
  
  link: "../#node-bf06"
  tooltip: "Small targeted patch and regression test"
}

BF07: "BF07 · Investigate / repair complex defect" {
  class: codex
  
  link: "../#node-bf07"
  tooltip: "Alternative investigation route"
}

BF08: "BF08 · Check targeted and broad CI" {
  class: system
  
  link: "../#node-bf08"
  tooltip: "Separate actionable failures from quota/infra"
}

BF09: "BF09 · Independent review and readiness" {
  class: chat
  
  link: "../#node-bf09"
  tooltip: "Confirm reproduction and intended outcome"
}

BF10: "BF10 · Approve merge / patch release?" {
  class: human
  shape: diamond
  link: "../#node-bf10"
  tooltip: "Merge and release are separate decisions"
}

BF01 -> BF02
BF02 -> BF03
BF03 -> BF04
BF04 -> BF02: "insufficient"
BF04 -> BF05: "ready"
BF05 -> BF06: "Jules"
BF05 -> BF07: "Codex / Agy"
BF06 -> BF08
BF07 -> BF08
BF08 -> BF09
BF09 -> BF06: "fix still needed"
BF09 -> BF10: "verified"
BF10 -> BF03: "deferred follow-up"
