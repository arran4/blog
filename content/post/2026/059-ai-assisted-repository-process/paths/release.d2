# Editable D2 source. Linked node IDs correspond to article headings.
direction: right
classes: {
  human: { style: { fill: "#FFF0C8"; stroke: "#AE791B"; font-color: "#533A09" } }
  chat: { style: { fill: "#DCEEFF"; stroke: "#2874AD"; font-color: "#163D5E" } }
  jules: { style: { fill: "#DEF6E2"; stroke: "#348B51"; font-color: "#17522B" } }
  codex: { style: { fill: "#EDE3FC"; stroke: "#784BAF"; font-color: "#402469" } }
  system: { style: { fill: "#F1F3F5"; stroke: "#6C7785"; font-color: "#303D4C" } }
}

RL01: "RL01 · Release candidate" {
  class: chat
  
  link: "../#node-rl01"
  tooltip: "From first, major, minor, patch or maintenance work"
}

RL02: "RL02 · Reconcile merged work and versions" {
  class: chat
  
  link: "../#node-rl02"
  tooltip: "Changelog, compatibility, dependency status"
}

RL03: "RL03 · Required release checks available?" {
  class: chat
  shape: diamond
  link: "../#node-rl03"
  tooltip: "Classify quotas, failing tests, infrastructure"
}

RL04: "RL04 · Restore verification or block" {
  class: chat
  
  link: "../#node-rl04"
  tooltip: "No fabricated pass or branch-protection bypass"
}

RL05: "RL05 · Authorise release?" {
  class: human
  shape: diamond
  link: "../#node-rl05"
  tooltip: "Explicit publication decision"
}

RL06: "RL06 · Tag and publish via established CI" {
  class: system
  
  link: "../#node-rl06"
  tooltip: "One safe release publisher per tag"
}

RL07: "RL07 · Verify artifacts and downstream effects" {
  class: chat
  
  link: "../#node-rl07"
  tooltip: "Validate actual release, not only workflow dispatch"
}

RL08: "RL08 · Follow-up, notes and next phase" {
  class: chat
  
  link: "../#node-rl08"
  tooltip: "Reconcile issues and select next work"
}

RL09: "RL09 · Human chooses next phase" {
  class: human
  shape: diamond
  link: "../#node-rl09"
  tooltip: "Do not silently start new project"
}

RL01 -> RL02
RL02 -> RL03
RL03 -> RL04: "missing mandatory evidence"
RL04 -> RL03: "checks restored"
RL03 -> RL05: "sufficient evidence"
RL05 -> RL02: "hold"
RL05 -> RL06: "approved"
RL06 -> RL07
RL07 -> RL08
RL08 -> RL09
RL09 -> RL02: "continue roadmap"
