  source-arrowhead.label: "chat findings"
  tooltip: "BG04 → BG05: chat findings"
  style.stroke: "#436B90"
  style.stroke-width: 3
  style.font-size: 21
}

BG06 -> BG09: {
  source-arrowhead.label: "coding prompt"
