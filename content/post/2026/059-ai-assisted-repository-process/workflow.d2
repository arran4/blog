# Canonical AI-assisted repository process (D2 v0.9.0).
# One diagram; source of truth for node IDs, actors, and transition routes.
# Entry choices are grouped in a start frame; other phases stay unframed to save space.
# Node labels use an ID/title and a visible plain-language description.
# The D2 node links and full article catalogue provide detailed instructions.
# Node labels are 26pt and connection labels 21pt to remain readable in PNG exports.
# Branch outcomes are positioned near the source via source-arrowhead.label.
# Long conditions remain in edge tooltips and in the linked node catalogue.
direction: down
classes: {
  human: { style: { fill: "#FFF1C8"; stroke: "#9C6813"; font-color: "#4D350E"; font-size: 26 } }
  chat: { style: { fill: "#E1F0FE"; stroke: "#2375B0"; font-color: "#153B5C"; font-size: 26 } }
  joint: { style: { fill: "#DDF6F5"; stroke: "#11837F"; font-color: "#084E4B"; font-size: 26 } }
  coding: { style: { fill: "#EFE5FC"; stroke: "#7851B3"; font-color: "#3D2367"; font-size: 26 } }
  github: { style: { fill: "#E9F3EF"; stroke: "#47836D"; font-color: "#163F31"; font-size: 26 } }
}

# Framed examples are an isolated legend, not a part of the process graph.
# No edges connect the legend's sample objects to real workflow nodes.
legend: {
  label: "LEGEND · ACTORS, SHAPES AND ROUTES"
  near: center-right
  direction: right
  label.near: top-center
  style: {
    fill: "#F9FBFF"
    stroke: "#324761"
    stroke-width: 5
    border-radius: 18
    font-color: "#20334D"
    font-size: 36
  }

  actors: {
    label: "ACTOR COLOURS"
    direction: down
    style: { fill: "#FFFFFF"; stroke: "#AFBED0"; stroke-width: 2; border-radius: 10; font-size: 29 }
    human_example: "Human" { class: human }
    chat_example: "Chat LLM" { class: chat }
    shared_example: "Human or Chat LLM" { class: joint }
    coding_example: "Coding LLM (Codex/Agy)" { class: coding }
    github_example: "GitHub / CI" { class: github }
  }

  shapes: {
    label: "PROCESS SYMBOLS"
    direction: down
    style: { fill: "#FFFFFF"; stroke: "#AFBED0"; stroke-width: 2; border-radius: 10; font-size: 29 }
    entry_example: "ENTRY" {
      shape: circle
      class: human
    }
    action_example: "ACTION" {
      shape: rectangle
      class: chat
    }
    decision_example: "DECISION" {
      shape: diamond
      class: joint
    }
    end_example: "TERMINAL" {
      shape: oval
      class: github
    }
  }

  routes: {
    label: "CONNECTION TYPES"
    direction: down
    style: { fill: "#FFFFFF"; stroke: "#AFBED0"; stroke-width: 2; border-radius: 10; font-size: 29 }

    normal: {
      direction: right
      style: { fill: transparent; stroke: transparent }
      from: "From" { shape: rectangle; style.font-size: 22 }
      to: "To" { shape: rectangle; style.font-size: 22 }
      from -> to: "Progress" { style.stroke: "#436B90"; style.stroke-width: 4; style.font-size: 24 }
    }
    approved: {
      direction: right
      style: { fill: transparent; stroke: transparent }
      from: "From" { shape: rectangle; style.font-size: 22 }
      to: "To" { shape: rectangle; style.font-size: 22 }
      from -> to: "Approved" { style.stroke: "#278352"; style.stroke-width: 4; style.font-size: 24 }
    }
    rework: {
      direction: right
      style: { fill: transparent; stroke: transparent }
      from: "From" { shape: rectangle; style.font-size: 22 }
      to: "Earlier" { shape: rectangle; style.font-size: 22 }
      from -> to: "Backtrack" { style.stroke: "#E08C2B"; style.stroke-width: 4; style.stroke-dash: 4; style.font-size: 24 }
    }
    blocked: {
      direction: right
      style: { fill: transparent; stroke: transparent }
      from: "From" { shape: rectangle; style.font-size: 22 }
      to: "Hold" { shape: rectangle; style.font-size: 22 }
      from -> to: "Deferred" { style.stroke: "#85919C"; style.stroke-width: 4; style.stroke-dash: 4; style.font-size: 24 }
    }
    cancelled: {
      direction: right
      style: { fill: transparent; stroke: transparent }
      from: "From" { shape: rectangle; style.font-size: 22 }
      to: "Stop" { shape: oval; style.font-size: 22 }
      from -> to: "Abandoned" { style.stroke: "#C53D48"; style.stroke-width: 4; style.font-size: 24 }
    }
  }
}

# Phase: start
# Select one of these six entry points; the frame is not a workflow step.
start: {
  label: "START HERE · pick one entry"
  label.near: top-center
  style: { fill: "#F2F7FF"; stroke: "#365C92"; stroke-width: 5; border-radius: 18; font-size: 38; font-color: "#16395B" }
  ST01: "ST01 · Initial release\nStart a new project or first release." {
    class: human
    shape: circle
    tooltip: "Human: A new project or first public version"
    link: "./#node-st01"
  }
  ST02: "ST02 · Planned change\nAsk for a feature or improvement." {
    class: human
    shape: circle
    tooltip: "Human: A feature or change of any size; classify scope later"
    link: "./#node-st02"
  }
  ST03: "ST03 · Bug or defect\nDescribe what is not working." {
    class: human
    shape: circle
    tooltip: "Human: An observed failure, including interactive Flutter problems"
    link: "./#node-st03"
  }
  ST04: "ST04 · Maintenance\nKeep dependencies and tooling current." {
    class: human
    shape: circle
    tooltip: "Human: Manual or automated upkeep; also may be folded into another workstream"
    link: "./#node-st04"
  }
  ST05: "ST05 · Existing work\nResume an issue, PR or stalled task." {
    class: human
    shape: circle
    tooltip: "Human: Resume an existing issue, PR tree or review checkpoint"
    link: "./#node-st05"
  }
  ST06: "ST06 · Release request\nPublish work that is already merged." {
    class: human
    shape: circle
    tooltip: "Human: Release-only entry that does not require new code"
    link: "./#node-st06"
  }
}

# Phase: intake
WS01: "WS01 · Open one workstream\nKeep related work in a single chat." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Carry objective, linked GitHub state and next action; multiple independent chats may run"
  link: "./#node-ws01"
}
WS02: "WS02 · Inspect current baseline\nCheck the code and outstanding work." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Check current repository state, existing specifications and outstanding dependencies"
  link: "./#node-ws02"
}
WS03: "WS03 · Select discovery depth?\nChoose how much planning is needed." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Choose proportionate analysis; do not demand a full roadmap for a trivial fix"
  link: "./#node-ws03"
}

WS04: "WS04 · Choose the starting route?\nRoute this request to the right process." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Route the entry as new work, bug, resumed PR or release-only"
  link: "./#node-ws04"
}

WS05: "WS05 · Save conversation link\nRecord a resumption pointer in Projects." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: If given a conversation link, add it to the owning arran4/projects file alongside the relevant issue/PR; do not replicate active work details"
  link: "./#node-ws05"
}

WS06: "WS06 · Read Projects handoff\nCheck related conversations and blockers." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Read current arran4/projects, matching repo handoff and overlapping updates; use it as a between-chat index not as a live issue tracker"
  link: "./#node-ws06"
}

# Phase: debug
BG01: "BG01 · Capture reproduction\nShow how the bug happens." {
  class: human
  shape: rectangle
  tooltip: "Human: Share observed and expected behaviour, stack traces, device or UI observations"
  link: "./#node-bg01"
}
BG02: "BG02 · How to debug?\nChoose who should investigate it." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Select human interactive, Chat LLM research or Coding LLM investigation"
  link: "./#node-bg02"
}
BG03: "BG03 · Interactive diagnosis\nReproduce and inspect the issue together." {
  class: human
  shape: rectangle
  tooltip: "Human: Especially for Flutter: reproduce with the human, copy evidence and results back to chat"
  link: "./#node-bg03"
}
BG04: "BG04 · Chat diagnoses bug\nInspect code and explain the evidence." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Investigate code or ask for focused coding-agent debugging when needed"
  link: "./#node-bg04"
}
BG05: "BG05 · Cause confirmed?\nDecide whether the diagnosis fits." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Compare candidate cause to observed failure and decide if more diagnosis is required"
  link: "./#node-bg05"
}

BG06: "BG06 · Prepare human diagnosis\nExplain steps and request specific evidence." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Explain the suspected cause, why human testing helps, step-by-step checks, expected observations, process and explicit questions"
  link: "./#node-bg06"
}

BG07: "BG07 · Prepare coding-agent diagnosis\nWrite a focused investigation prompt." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Give the human a coding-agent prompt with reproduction, context, tests and expected diagnostic evidence"
  link: "./#node-bg07"
}

BG08: "BG08 · Coding-agent investigation\nInvestigate with repository tools and tests." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM: Reproduce the issue, gather test or log evidence and report findings without assuming the original hypothesis was correct"
  link: "./#node-bg08"
}

BG09: "BG09 · Specify regression coverage\nPlan a test for the original failure." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Specify a regression test and appropriate TXTAR/txtar or broad scenario evidence that demonstrates the behaviour"
  link: "./#node-bg09"
}

# Phase: spec
PL01: "PL01 · State detailed intent\nExplain the goal, constraints and examples." {
  class: human
  shape: rectangle
  tooltip: "Human: Describe what, why, constraints, examples and desired approach; answer and ask questions"
  link: "./#node-pl01"
}
PL02: "PL02 · Ask clarifying questions\nAsk what is missing or unclear." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Ask targeted questions; revise scope after every material change"
  link: "./#node-pl02"
}
PL03: "PL03 · Contradictions found?\nCheck for incompatible requirements." {
  class: chat
  shape: diamond
  tooltip: "Chat LLM: Challenge incompatible requirements, tests or architecture; revisit earlier decisions"
  link: "./#node-pl03"
}
PL04: "PL04 · Resolve ambiguities\nAgree on answers or defer open questions." {
  class: human
  shape: rectangle
  tooltip: "Human: Discuss alternatives, settle contradictions, or defer non-blocking questions explicitly"
  link: "./#node-pl04"
}
PL05: "PL05 · Enough specified?\nDecide whether there is enough to start." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Advance when sufficient, not necessarily complete; otherwise loop or park"
  link: "./#node-pl05"
}
SP01: "SP01 · Reconcile GitHub issues\nMatch the work to existing GitHub issues." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Search existing issues and PRs; align expected outcomes and acceptance cases"
  link: "./#node-sp01"
}
SP02: "SP02 · Issue record adequate?\nCheck whether an issue covers the work." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Check missing tests, issue ownership, resolving scope and change implications"
  link: "./#node-sp02"
}
SP03: "SP03 · Request issue approval\nGet approval for new or rewritten issues." {
  class: human
  shape: rectangle
  tooltip: "Human: Approve new issue creation or significant scope changes; maintain existing records when authorised"
  link: "./#node-sp03"
}
SP04: "SP04 · Persist accepted spec\nRecord agreed requirements in GitHub." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Record decisions, open questions, criteria and dependencies in GitHub and linked conversation"
  link: "./#node-sp04"
}

PL07: "PL07 · Contradictions resolved?\nDecide whether more questions are needed." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Confirm conflicts were resolved, deferred or need another round of clarification"
  link: "./#node-pl07"
}

SP05: "SP05 · Issue approval received?\nCheck whether the changed scope is approved." {
  class: human
  shape: diamond
  tooltip: "Human: Approve an entirely new issue or significant change of specification, or hold it until clarified"
  link: "./#node-sp05"
}

SP06: "SP06 · Repository already exists?\nChoose existing source or bootstrap." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: After accepted requirements are recorded, choose an existing repository or approved new repo bootstrap"
  link: "./#node-sp06"
}

# Phase: tree
TR01: "TR01 · Work size and dependency?\nDecide whether one PR is enough." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Choose scope from dependencies and likely conflicts, not arbitrary linear stacking"
  link: "./#node-tr01"
}
TR02: "TR02 · Plan PR dependency tree\nMap PR dependencies and merge order." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Map sibling PRs that can merge independently and dependent children that must wait"
  link: "./#node-tr02"
}
TR03: "TR03 · Select runnable node\nPick work that is ready and unblocked." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Choose a ready node; if one branch blocks, advance an independent sibling"
  link: "./#node-tr03"
}
TR05: "TR05 · Bootstrap repository\nSet up the repo, tests and documentation." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: After human scope approval, initialise the repository, essential CI, documentation and licence, delegating source setup to the coding model as needed"
  link: "./#node-tr05"
}
TR04: "TR04 · Dogfood checkpoint\nTest a useful intermediate milestone." {
  class: human
  shape: rectangle
  tooltip: "Human: Confirm which portion of the tree is sufficient to test or merge now"
  link: "./#node-tr04"
}

TR06: "TR06 · Runnable branch available?\nChoose ready work, defer or cancel." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Check PR dependencies to find an unblocked node or preserve a blocker/cancellation"
  link: "./#node-tr06"
}

TR07: "TR07 · Dogfood milestone needed?\nDecide whether to test the milestone." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: After a PR-tree checkpoint, decide if a runnable milestone needs human testing before closeout"
  link: "./#node-tr07"
}

# Phase: execution
EX01: "EX01 · Who implements?\nChoose between a direct fix and an agent." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: For small changes try direct Chat LLM fix when able; otherwise write a prompt for Codex/Agy"
  link: "./#node-ex01"
}
EX02: "EX02 · Prepare implementation\nWrite an actionable implementation prompt." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Specify accepted issue state, exact branch, constraints, tests, dependency tree and expected PRs"
  link: "./#node-ex02"
}
EX03: "EX03 · Code and test locally\nBuild the change and run real tests." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM (Codex/Agy): Use agent in interactive or YOLO container; iterate on code, tests and generator output"
  link: "./#node-ex03"
}
EX04: "EX04 · Publish PR tree\nPush code and open linked pull requests." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM (Codex/Agy): Push real commits and create the promised PRs, with explicit dependent bases and linked issues"
  link: "./#node-ex04"
}
EX05: "EX05 · Chat direct fix\nMake and test a small change in chat." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Use available tooling to edit and test an isolated authorised branch, publish an inspectable PR"
  link: "./#node-ex05"
}

# Phase: review
RV01: "RV01 · Inspect actual PR state\nInspect what the PR actually contains." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Verify published commits, comments, PR metadata, dependencies and fresh tests"
  link: "./#node-rv01"
}
RV02: "RV02 · Inspect CI evidence\nRead check results and missing evidence." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Required checks cannot be marked passed if absent; rerun or use accepted alternatives"
  link: "./#node-rv02"
}
RV03: "RV03 · Review correctness?\nCompare the PR with requirements and tests." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Check behaviour, issue match, closing keywords, test quality, conflicts and merge ordering"
  link: "./#node-rv03"
}
RV04: "RV04 · What needs changing?\nChoose the right correction or review path." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Route repair to smallest appropriate stage, including back to Q&A and issue specifications"
  link: "./#node-rv04"
}
RV05: "RV05 · Small repair\nFix a straightforward issue or conflict." {
  class: human
  shape: rectangle
  tooltip: "Human: Resolve trivial conflict or tiny fix; Chat may patch when authorised, then republish and review"
  link: "./#node-rv05"
}
RV06: "RV06 · Complex correction\nSend a focused request to a coding agent." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Produce targeted prompt for Codex/Agy; repair existing branch/PR when safe"
  link: "./#node-rv06"
}
RV07: "RV07 · Human PR review\nRead and test the proposed changes." {
  class: human
  shape: rectangle
  tooltip: "Human: Read changes, test where appropriate, request redesign, defer, or approve"
  link: "./#node-rv07"
}
RV08: "RV08 · Merge approved?\nDecide whether this PR may be merged." {
  class: human
  shape: diamond
  tooltip: "Human: Explicit approval; passing CI or model readiness is not merge authority"
  link: "./#node-rv08"
}
RV09: "RV09 · Merge eligible node\nMerge a reviewed, eligible pull request." {
  class: github
  shape: rectangle
  tooltip: "GitHub / CI: Merge only valid, approved PR with required checks and dependency prerequisites satisfied"
  link: "./#node-rv09"
}
RV10: "RV10 · More work in PR tree?\nContinue another PR or close the milestone." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Update bases and conflicts; choose another ready sibling or pause dependent branch"
  link: "./#node-rv10"
}

RV12: "RV12 · Extra verification needed?\nChoose normal review or more evidence." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: After PR review, route bug/UI evidence to verification, objections to repair, otherwise human merge decision"
  link: "./#node-rv12"
}

RV13: "RV13 · Human verifies behavior\nProvide build and practical test steps." {
  class: human
  shape: rectangle
  tooltip: "Human: Run application or build locally, check the proposed bug diagnosis or UI change and return precise observations"
  link: "./#node-rv13"
}

RV14: "RV14 · Observed behavior correct?\nAccept evidence or reinvestigate failures." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Check visual/manual/automated evidence and route a wrong diagnosis to bug intake or a faulty patch to repair"
  link: "./#node-rv14"
}

RV15: "RV15 · Who verifies the UI?\nChoose automated proof or human testing." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Use Playwright or a reliable UI harness where suitable, otherwise human interactive device/local testing"
  link: "./#node-rv15"
}

RV16: "RV16 · Automate visual proof\nAttach UI captures or scenario results." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM or Chat tooling: Produce Playwright UI tests, golden captures or scenario previews in PR/chat for verification"
  link: "./#node-rv16"
}

RV17: "RV17 · Required CI available?\nCheck whether required checks are satisfied." {
  class: chat
  shape: diamond
  tooltip: "Chat LLM: Evaluate required checks, pending, failure and private quota; do not claim missing CI has passed"
  link: "./#node-rv17"
}

QA01: "QA01 · Check test evidence\nReview unit, regression and broad scenarios." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Assess updated regression tests, integration coverage, TXTAR/txtar CLI or API examples and visible end-to-end evidence in PR"
  link: "./#node-qa01"
}

# Phase: close
CL01: "CL01 · Audit issues and PRs\nConfirm that the right issues are resolved." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Check Fixes/Closes references, issue statuses, acceptance evidence, final implementation notes"
  link: "./#node-cl01"
}
CL02: "CL02 · Notify dependencies\nUpdate anything that depends on this work." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Check version constraints, dependent PRs, projects and actionable update notices"
  link: "./#node-cl02"
}
CL03: "CL03 · Refresh Projects handoff\nKeep only current links and next steps." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Update arran4/projects with roadmap, workstream and current milestone"
  link: "./#node-cl03"
}
CL04: "CL04 · Update PR repository\nRecord announcement tasks and readiness." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Update arran4/public-relations with accurate materials or future campaign tasks"
  link: "./#node-cl04"
}

CL05: "CL05 · Park Projects handoff\nSave the blocker and resumption link." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: When pausing, update arran4/projects with current chat link, blocker, next action and relevant issue/PR, not duplicate task details"
  link: "./#node-cl05"
}

CL06: "CL06 · Retire Projects handoff\nKeep useful links, mark work stopped." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: When abandoning, preserve a concise reason and link, without pretending source issues or PRs were completed"
  link: "./#node-cl06"
}

# Phase: release
RL01: "RL01 · Recommend release intent\nChoose whether and how to release this work." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Use accepted scope, roadmap, merged changes and release guidance; patch may be routine if authorised"
  link: "./#node-rl01"
}
RL02: "RL02 · Publish now?\nDecide whether it is time to publish." {
  class: human
  shape: diamond
  tooltip: "Human: May choose no release, normal versioned release, or delayed/public opening"
  link: "./#node-rl02"
}
RL03: "RL03 · First public opening?\nCheck whether the repo must become public." {
  class: human
  shape: diamond
  tooltip: "Human: If private-to-public, require broader quality, provenance, licence, copyright and link checks"
  link: "./#node-rl03"
}
RL04: "RL04 · Audit public exposure\nInspect secrets, licences and history." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Inspect repository history, links, copyright, documentation, quality and release assets"
  link: "./#node-rl04"
}
RL05: "RL05 · History rewrite needed?\nAsk before rewriting published Git history." {
  class: human
  shape: diamond
  tooltip: "Human: Force-push or rewrite only on explicit informed approval; consider collaborators and tags"
  link: "./#node-rl05"
}
RL06: "RL06 · Approve visibility change\nApprove making the repository public." {
  class: human
  shape: rectangle
  tooltip: "Human: Make public only after verified audit and approval"
  link: "./#node-rl06"
}
RL07: "RL07 · Run release workflow\nRun the approved tagging and release action." {
  class: github
  shape: rectangle
  tooltip: "GitHub / CI: Use documented release-safe action to tag and publish; no duplicate release publisher"
  link: "./#node-rl07"
}
RL08: "RL08 · Release verified?\nCheck tags, assets and distribution." {
  class: chat
  shape: diamond
  tooltip: "Chat LLM: Confirm actual tag, release, packages and downstream impact; update tracker and announcements"
  link: "./#node-rl08"
}

RL09: "RL09 · Public exposure safe?\nDecide if audit findings block publication." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Review secrets, licensing, ownership and history audit results; substantial unresolved exposure returns to specification"
  link: "./#node-rl09"
}

# Phase: end
EN01: "EN01 · Completed\nThe agreed milestone is finished." {
  class: github
  shape: oval
  near: bottom-center
  tooltip: "GitHub / CI: Work and any authorised release completed; issue and tracker state reconciled"
  link: "./#node-en01"
}
EN02: "EN02 · Deferred / blocked\nRecord what is blocked and when to resume." {
  class: github
  shape: oval
  tooltip: "GitHub / CI: Record what remains, owner, dependency, and the condition for resuming"
  link: "./#node-en02"
}
EN03: "EN03 · Abandoned\nStop the work and record why." {
  class: human
  shape: oval
  tooltip: "Human: Document cancellation, superseded PRs, issue closure/retention and change of direction"
  link: "./#node-en03"
}

# Rectangles have a single workflow exit; diamonds make conditional choices.
# Only standard completion is anchored at the bottom. Exceptional stops may branch elsewhere.
# Long arrows identify their destination node at the arrowhead.
start.ST01 -> WS01: {
  tooltip: "ST01 → WS01: repo/initial"
  style.stroke: "#436B90"
  style.stroke-width: 3
  style.font-size: 21
}

start.ST02 -> WS01: {
  tooltip: "ST02 → WS01: planned change"
  style.stroke: "#436B90"
  style.stroke-width: 3
  style.font-size: 21
}

start.ST04 -> WS01: {
  tooltip: "ST04 → WS01: maintenance / audit"
  style.stroke: "#436B90"
  style.stroke-width: 3
  style.font-size: 21
}

