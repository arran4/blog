# Canonical AI-assisted repository process (D2 v0.9.0).
# One diagram; source of truth for node IDs, actors, and transition routes.
# Phases are documented in the blog; only the entry choices have a grouping frame; phases use comments.
# Node labels use an ID/title and a visible plain-language description.
# The D2 node links and full article catalogue provide detailed instructions.
# Node labels are 26pt and connection labels 21pt to remain readable in PNG exports.
# Branch outcomes are positioned near the source via source-arrowhead.label.
# Long conditions remain in edge tooltips and in the linked node catalogue.
direction: down
classes: {
  human: { style: { fill: "#FFF1C8"; stroke: "#9C6813"; font-color: "#4D350E"; font-size: 26 } }
  chat: { style: { fill: "#E1F0FE"; stroke: "#2375B0"; font-color: "#153B5C"; font-size: 26 } }
  joint: { style: { fill: "#DDF6F5"; stroke: "#11837F"; font-color: "#084E4B"; font-size: 26 } }
  coding: { style: { fill: "#EFE5FC"; stroke: "#7851B3"; font-color: "#3D2367"; font-size: 26 } }
  github: { style: { fill: "#E9F3EF"; stroke: "#47836D"; font-color: "#163F31"; font-size: 26 } }
}


# Entry choices are deliberately grouped and form the top of the main flow.
start_here: {
  label: "START HERE · CHOOSE ONE ENTRY POINT"
  direction: right
  style: { fill: "#F4FAFF"; stroke: "#315F8A"; stroke-width: 5; border-radius: 16; font-size: 34; font-color: "#173B5C" }
  ST01: "ST01 · Initial release\nBegin a new repository or initial release." {
    class: human
    shape: circle
    tooltip: "Human: A new project or first public version"
    link: "./#node-st01"
  }

  ST02: "ST02 · Planned change\nRequest a feature or improvement." {
    class: human
    shape: circle
    tooltip: "Human: A feature or change of any size; classify scope later"
    link: "./#node-st02"
  }

  ST03: "ST03 · Bug or defect\nReport unexpected behaviour to be fixed." {
    class: human
    shape: circle
    tooltip: "Human: An observed failure, including interactive Flutter problems"
    link: "./#node-st03"
  }

  ST04: "ST04 · Maintenance\nStart dependency, tooling or audit upkeep." {
    class: human
    shape: circle
    tooltip: "Human: Manual or automated upkeep; also may be folded into another workstream"
    link: "./#node-st04"
  }

  ST05: "ST05 · Existing work\nResume an issue, PR or paused conversation." {
    class: human
    shape: circle
    tooltip: "Human: Resume an existing issue, PR tree or review checkpoint"
    link: "./#node-st05"
  }

  ST06: "ST06 · Release request\nConsider releasing already merged work." {
    class: human
    shape: circle
    tooltip: "Human: Release-only entry that does not require new code"
    link: "./#node-st06"
  }
}

# Phase: WS
WS01: "WS01 · Open one workstream\nOpen or resume one focused conversation." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Keep one coherent workstream in chat, linking its canonical issues, PRs and Project coordination record."
  link: "./#node-ws01"
}

WS02: "WS02 · Inspect current baseline\nInspect issues, PRs and the current code." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Re-read the current GitHub baseline and the Projects coordination record before making new assumptions."
  link: "./#node-ws02"
}

WS03: "WS03 · Select discovery depth?\nChoose planning, debugging or resumption." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Route the request by its actual goal; all starts go through Projects coordination; do not force major planning for routine tasks."
  link: "./#node-ws03"
}

WS04: "WS04 · Register conversation in Projects\nLink this chat and its current objective." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: When given a conversation URL, add or update a lightweight Projects coordination pointer in the owning repo/project file; do not mirror issue details."
  link: "./#node-ws04"
}

WS05: "WS05 · Park checkpoint in Projects\nStore blockers, next action and chat link." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Before a pause, record only the source PR/issue links, current blocker, resume condition and conversation URL in Projects; routine low-risk Projects changes may be autonomously merged under its own policy."
  link: "./#node-ws05"
}

WS06: "WS06 · Close Projects handoff\nRecord cancellation without a second tracker." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: On human-authorised abandonment, record why the work stopped and update or remove stale Projects handoff links, preserving canonical issues/PR history."
  link: "./#node-ws06"
}

# Phase: BG
BG01: "BG01 · Capture reproduction\nRecord steps to reproduce and expected results." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Capture reproduction, observed-versus-expected behaviour, logs, versions, screenshots and context."
  link: "./#node-bg01"
}

BG02: "BG02 · Who investigates?\nRoute to chat, coding agent or human." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Select human interactive, Chat LLM research or Coding LLM investigation"
  link: "./#node-bg02"
}

BG03: "BG03 · Human interactive investigation\nRun the app and report findings to chat." {
  class: human
  shape: rectangle
  tooltip: "Human: Execute local UI or debugger steps from the Chat LLM request and return reproducible evidence."
  link: "./#node-bg03"
}

BG04: "BG04 · Chat investigates\nAnalyse evidence and try a small fix." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Investigate directly where tools allow; a verified fix proceeds through issue and PR workflow, otherwise escalate with focused evidence."
  link: "./#node-bg04"
}

BG05: "BG05 · Root cause supported?\nCheck the diagnosis against the evidence." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Evaluate whether logs, reproduction, tests and human feedback support the root cause; loop or reframe if they do not."
  link: "./#node-bg05"
}

BG06: "BG06 · Prepare coding-agent diagnosis\nWrite the prompt, evidence and test request." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Supply the coding-agent investigation prompt to the human with reproduction, hypotheses, testing expectations and exact PR/issue context."
  link: "./#node-bg06"
}

BG07: "BG07 · Specify regression proof\nPlan a failing test and scenario evidence." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Specify the test to add or update, with unit, txtar, integration or scenario proof that would demonstrate the bug and prevent a recurrence; implement it with the fix later."
  link: "./#node-bg07"
}

BG08: "BG08 · Request human investigation\nExplain why and provide runnable steps." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Explain why a manual device/UI debugger run is needed, give steps, flowchart or rationale, and ask the human for exact observations and output."
  link: "./#node-bg08"
}

BG09: "BG09 · Coding agent diagnoses\nRun investigations and return evidence." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM: Investigate the prepared prompt in a repository/worktree, run experiments and tests, and send findings back to Chat LLM for verification; do not self-approve the diagnosis."
  link: "./#node-bg09"
}

# Phase: PL
PL01: "PL01 · State detailed intent\nExplain the goal, constraints and examples." {
  class: human
  shape: rectangle
  tooltip: "Human: Describe what, why, constraints, examples and desired approach; answer and ask questions"
  link: "./#node-pl01"
}

PL02: "PL02 · Ask clarifying questions\nAsk what is missing or unclear." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Ask targeted questions; revise scope after every material change"
  link: "./#node-pl02"
}

PL03: "PL03 · Contradictions found?\nCheck whether requirements disagree." {
  class: chat
  shape: diamond
  tooltip: "Chat LLM: Search for conflicts in requirements, design, scope, tests and assumptions; route yes to resolution and no to sufficiency check."
  link: "./#node-pl03"
}

PL04: "PL04 · Resolve contradictions\nDiscuss, decide or defer conflicting needs." {
  class: human
  shape: rectangle
  tooltip: "Human: Decide between conflicting requirements, ask follow-up questions, then recheck the revised specification."
  link: "./#node-pl04"
}

PL05: "PL05 · Enough specified?\nDecide whether there is enough to start." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Advance when sufficient, not necessarily complete; otherwise loop or park"
  link: "./#node-pl05"
}

# Phase: SP
SP01: "SP01 · Reconcile GitHub issues\nMatch the work to existing GitHub issues." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Search existing issues and PRs; align expected outcomes and acceptance cases"
  link: "./#node-sp01"
}

SP02: "SP02 · Issue record adequate?\nCheck whether an issue covers the work." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Check missing tests, issue ownership, resolving scope and change implications"
  link: "./#node-sp02"
}

SP03: "SP03 · Issue change approved?\nApprove a new issue or major rewrite." {
  class: human
  shape: diamond
  tooltip: "Human: Decide whether an issue should be created or materially rewritten; routine authorised updates to existing issues need no fresh approval."
  link: "./#node-sp03"
}

SP04: "SP04 · Persist accepted spec\nKeep approved detail in issues and PRs." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Record canonical requirements and acceptance checks in issues and PR descriptions, not duplicated into Projects."
  link: "./#node-sp04"
}

SP05: "SP05 · New repository required?\nChoose bootstrap or an existing repo." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: After recording canonical issue/spec requirements, decide if a new repository needs bootstrapping or an existing repository can proceed."
  link: "./#node-sp05"
}

# Phase: TR
TR01: "TR01 · Work size and dependency?\nDecide whether one PR is enough." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Choose scope from dependencies and likely conflicts, not arbitrary linear stacking"
  link: "./#node-tr01"
}

TR02: "TR02 · Plan PR dependency tree\nMap PR dependencies and merge order." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Map sibling PRs that can merge independently and dependent children that must wait"
  link: "./#node-tr02"
}

TR03: "TR03 · Runnable PR available?\nChoose an unblocked branch or park work." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Choose an independently runnable leaf; if none is available record why work is blocked; cancel only with human agreement."
  link: "./#node-tr03"
}

TR05: "TR05 · Bootstrap repository\nSet up the repo, tests and documentation." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: After human scope approval, initialise the repository, essential CI, documentation and licence, delegating source setup to the coding model as needed"
  link: "./#node-tr05"
}

TR04: "TR04 · Dogfood verification needed?\nDecide how to test this PR milestone." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: This reachable gate follows publication of each PR; decide whether to prepare an explicit dogfood/UI test before review."
  link: "./#node-tr04"
}

TR06: "TR06 · Prepare dogfood test plan\nAsk for human or automated milestone proof." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Select practical UI/dogfood steps, Playwright, screenshot, prototype, txtar or scenario evidence for the current PR milestone, and attach or request evidence for review."
  link: "./#node-tr06"
}

# Phase: EX
EX01: "EX01 · Who implements?\nUse chat directly or prompt a coding agent." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Chat should fix small scoped changes itself when it has adequate access and verification; otherwise delegate with a prompt."
  link: "./#node-ex01"
}

EX02: "EX02 · Prepare implementation\nWrite a runnable prompt with test criteria." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Include branch, canonical issue acceptance criteria, PR dependencies, regression tests and txtar/scenario/integration tests where helpful."
  link: "./#node-ex02"
}

EX03: "EX03 · Code and test locally\nImplement the change and prove its behaviour." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM: Write or update unit and larger end-to-end, txtar, integration or scenario proof, then run tests and inspect output."
  link: "./#node-ex03"
}

EX04: "EX04 · Publish PR tree\nPush code and open linked pull requests." {
  class: coding
  shape: rectangle
  tooltip: "Coding LLM (Codex/Agy): Push real commits and create the promised PRs, with explicit dependent bases and linked issues"
  link: "./#node-ex04"
}

EX05: "EX05 · Chat direct fix\nFix a small change and run its tests." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Directly implement when capable, add focused regression and scenario proof, publish to PR, otherwise delegate to EX02."
  link: "./#node-ex05"
}

# Phase: RV
RV01: "RV01 · Inspect actual PR state\nInspect what the PR actually contains." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Verify published commits, comments, PR metadata, dependencies and fresh tests"
  link: "./#node-rv01"
}

RV02: "RV02 · CI evidence usable?\nDistinguish passing, missing and blocked CI." {
  class: chat
  shape: diamond
  tooltip: "Chat LLM: Check current head and mandatory CI evidence, distinguish missing quota from actual success; route required blocked checks to coordination hold."
  link: "./#node-rv02"
}

RV03: "RV03 · Review correctness?\nReview the requirements and regression proof." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Review correctness, test quality, realistic high-level txtar/scenario coverage, issue/PR traceability and code-level tests."
  link: "./#node-rv03"
}

RV04: "RV04 · What needs changing?\nChoose the right correction or review path." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Route repair to smallest appropriate stage, including back to Q&A and issue specifications"
  link: "./#node-rv04"
}

RV05: "RV05 · Small repair\nFix a straightforward issue or conflict." {
  class: human
  shape: rectangle
  tooltip: "Human: Resolve trivial conflict or tiny fix; Chat may patch when authorised, then republish and review"
  link: "./#node-rv05"
}

RV06: "RV06 · Complex correction\nSend a focused request to a coding agent." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Produce targeted prompt for Codex/Agy; repair existing branch/PR when safe"
  link: "./#node-rv06"
}

RV07: "RV07 · Human PR review\nReview changes and verify user-facing results." {
  class: human
  shape: rectangle
  tooltip: "Human: Review the PR and test meaningful UI or bug behaviour; delegate screenshots, Playwright or prototypes when they can provide reliable evidence."
  link: "./#node-rv07"
}

RV08: "RV08 · Merge approved?\nDecide whether this PR may be merged." {
  class: human
  shape: diamond
  tooltip: "Human: Explicit approval; passing CI or model readiness is not merge authority"
  link: "./#node-rv08"
}

RV09: "RV09 · Merge eligible node\nMerge a reviewed, eligible pull request." {
  class: github
  shape: rectangle
  tooltip: "GitHub / CI: Merge only valid, approved PR with required checks and dependency prerequisites satisfied"
  link: "./#node-rv09"
}

RV10: "RV10 · More work in PR tree?\nContinue siblings or close the milestone." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Update bases and conflicts; choose another ready sibling or pause dependent branch"
  link: "./#node-rv10"
}

RV11: "RV11 · What verification is needed?\nChoose manual, automated or none." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: After reviewing the PR, decide whether interactive UI/bug proof or automated Playwright/scenario evidence is needed; do not assume an earlier bug hypothesis was correct."
  link: "./#node-rv11"
}

RV12: "RV12 · Human verifies the result\nRun the change and confirm real behaviour." {
  class: human
  shape: rectangle
  tooltip: "Human: Run a local or installed build, reproduce the original bug, test changed UI and report whether the analysis/PR actually solved it; return discrepancies for revision."
  link: "./#node-rv12"
}

RV13: "RV13 · Automate the proof\nUse Playwright, scenarios or previews." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Provide or delegate trusted UI automation, Playwright, screenshots, previews, integration tests or txtar/scenario evidence, attached to PR or shared for human assessment."
  link: "./#node-rv13"
}

RV14: "RV14 · Review evidence accepted?\nFix objections or request merge approval." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Compare manual and automated results against issue requirements and original bug hypothesis; route incorrect analysis back to diagnosis or issue correction."
  link: "./#node-rv14"
}

# Phase: CL
CL01: "CL01 · Audit issues and PRs\nCheck issues, tests and PR closeout evidence." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Verify canonical issues, resolving keywords, regression and scenario proof, remaining blockers and correct PR merge state."
  link: "./#node-cl01"
}

CL02: "CL02 · Notify dependencies\nUpdate anything that depends on this work." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Check version constraints, dependent PRs, projects and actionable update notices"
  link: "./#node-cl02"
}

CL03: "CL03 · Sync Projects coordination\nUpdate conversation pointer and resume state." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Keep the arran4/projects handoff index current at milestone closeout; issues/PRs carry implementation detail, Projects links conversation, status, blockers and next action."
  link: "./#node-cl03"
}

CL04: "CL04 · Update PR repository\nRecord announcement tasks and readiness." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Update arran4/public-relations with accurate materials or future campaign tasks"
  link: "./#node-cl04"
}

# Phase: RL
RL01: "RL01 · Recommend release intent\nChoose whether and how to release this work." {
  class: joint
  shape: rectangle
  tooltip: "Human or Chat LLM: Use accepted scope, roadmap, merged changes and release guidance; patch may be routine if authorised"
  link: "./#node-rl01"
}

RL02: "RL02 · Publish now?\nDecide whether it is time to publish." {
  class: human
  shape: diamond
  tooltip: "Human: May choose no release, normal versioned release, or delayed/public opening"
  link: "./#node-rl02"
}

RL03: "RL03 · First public opening?\nCheck whether the repo must become public." {
  class: human
  shape: diamond
  tooltip: "Human: If private-to-public, require broader quality, provenance, licence, copyright and link checks"
  link: "./#node-rl03"
}

RL04: "RL04 · Audit public exposure\nInspect history, secrets, links and licences." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Inspect repository history, links, copyright, documentation, quality and release assets"
  link: "./#node-rl04"
}

RL05: "RL05 · History rewrite needed?\nAsk before rewriting published Git history." {
  class: human
  shape: diamond
  tooltip: "Human: Force-push or rewrite only on explicit informed approval; consider collaborators and tags"
  link: "./#node-rl05"
}

RL06: "RL06 · Approve visibility change\nApprove making the repository public." {
  class: human
  shape: rectangle
  tooltip: "Human: Make public only after verified audit and approval"
  link: "./#node-rl06"
}

RL07: "RL07 · Run release workflow\nRun the approved tagging and release action." {
  class: github
  shape: rectangle
  tooltip: "GitHub / CI: Use documented release-safe action to tag and publish; no duplicate release publisher"
  link: "./#node-rl07"
}

RL08: "RL08 · Release verified?\nConfirm the actual published result." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Decide whether published assets, tag, package, repository visibility and downstream checks really succeeded; otherwise record failed release."
  link: "./#node-rl08"
}

RL09: "RL09 · Public audit passed?\nDecide if publication requirements are met." {
  class: joint
  shape: diamond
  tooltip: "Human or Chat LLM: Determine whether secret, history, licence, link and quality checks are adequate; unresolved fundamental issues return to design, while blocking items pause release."
  link: "./#node-rl09"
}

RL10: "RL10 · Inspect published assets\nCheck tag, packages and downstream state." {
  class: chat
  shape: rectangle
  tooltip: "Chat LLM: Inspect actual GitHub tag, release, uploaded artifacts, package/overlay and visibility after the release workflow, then hand off the outcome for confirmation."
  link: "./#node-rl10"
}

# Phase: EN
EN01: "EN01 · Completed\nFinish the verified milestone at the end." {
  class: github
  shape: oval
  tooltip: "GitHub / CI: Work and any authorised release completed; issue and tracker state reconciled"
  link: "./#node-en01"
}

EN02: "EN02 · Deferred or blocked\nRecord the blocker and how to resume." {
  class: github
  shape: oval
  tooltip: "Chat LLM: Record a concrete resumption trigger, owner, conversation URL and authoritative issue/PR links in Projects when applicable."
  link: "./#node-en02"
}

EN03: "EN03 · Abandoned\nRecord why and close the handoff." {
  class: human
  shape: oval
  tooltip: "Human: Explicitly abandon the work and reconcile obsolete issues/PRs, with a concise Projects coordination update."
  link: "./#node-en03"
}

