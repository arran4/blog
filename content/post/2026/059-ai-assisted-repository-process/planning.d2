# D2 subprocess source; actor colour identifies responsibility. Detailed rules are in the linked node catalogue.
direction: right
classes: {
  human: { style: { fill: "#FFF0C8"; stroke: "#AE791B"; font-color: "#533A09" } }
  chat: { style: { fill: "#DCEEFF"; stroke: "#2874AD"; font-color: "#163D5E" } }
  jules: { style: { fill: "#DEF6E2"; stroke: "#348B51"; font-color: "#17522B" } }
  codex: { style: { fill: "#EDE3FC"; stroke: "#784BAF"; font-color: "#402469" } }
  system: { style: { fill: "#F1F3F5"; stroke: "#6C7785"; font-color: "#303D4C" } }
}

P01: "P01 · Identify entry point" {
  class: human
  tooltip: "Identify entry point"
  link: "./#node-p01"
}
P05: "P05 · Clarify requirements" {
  class: human
  tooltip: "Clarify requirements"
  link: "./#node-p05"
}
P07: "P07 · Approve roadmap?" {
  class: system
  shape: diamond
  tooltip: "Approve roadmap?"
  link: "./#node-p07"
}
P09: "P09 · Create new issues?" {
  class: system
  shape: diamond
  tooltip: "Create new issues?"
  link: "./#node-p09"
}
P13: "P13 · Authorize execution" {
  class: human
  tooltip: "Authorize execution"
  link: "./#node-p13"
}
P02: "P02 · Establish workstream" {
  class: chat
  tooltip: "Establish workstream"
  link: "./#node-p02"
}
P03: "P03 · Discover baseline" {
  class: chat
  tooltip: "Discover baseline"
  link: "./#node-p03"
}
P04: "P04 · Research alternatives" {
  class: chat
  tooltip: "Research alternatives"
  link: "./#node-p04"
}
P06: "P06 · Build roadmap" {
  class: chat
  tooltip: "Build roadmap"
  link: "./#node-p06"
}
P08: "P08 · Reconcile issue register" {
  class: chat
  tooltip: "Reconcile issue register"
  link: "./#node-p08"
}
P11: "P11 · Choose implementation unit" {
  class: chat
  tooltip: "Choose implementation unit"
  link: "./#node-p11"
}
P12: "P12 · Set acceptance evidence" {
  class: chat
  tooltip: "Set acceptance evidence"
  link: "./#node-p12"
}
P10: "P10 · Record durable issues" {
  class: system
  tooltip: "Record durable issues"
  link: "./#node-p10"
}

P01 -> P02
P02 -> P03
P03 -> P04
P04 -> P05
P05 -> P04: "refine"
P05 -> P06: "aligned"
P06 -> P07
P07 -> P04: "rework"
P07 -> P08: "accepted"
P08 -> P09: "new issues found"
P09 -> P10: "yes"
P09 -> P11: "no / existing"
P10 -> P11
P11 -> P12
P12 -> P13
P13 -> P02: "restart as new workstream"
