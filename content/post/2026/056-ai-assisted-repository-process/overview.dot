digraph Workflow {
  graph [rankdir=TB, bgcolor="white", label="AI-assisted repository process | overview", labelloc=t, fontsize=22, fontname="DejaVu Sans", fontcolor="#172638", pad="0.45", nodesep="0.38", ranksep="0.70", splines=polyline, compound=true, newrank=true];
  node [fontname="DejaVu Sans", fontsize=11, color="#24374C", penwidth=1.1, margin="0.16,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#455A6B", arrowsize=0.7, penwidth=1.15];
  subgraph cluster_human {
    label="Human"; fontname="DejaVu Sans"; fontsize=14; fontcolor="#AF8300"; color="#AF8300"; fillcolor="#FFF1BE"; style="rounded,filled"; penwidth=1.0; margin=14;
    O01 [shape=box, style="rounded,filled", fillcolor="white", color="#AF8300", label=< <FONT POINT-SIZE="9" COLOR="#516273">O01</FONT><BR/><B>Select starting point</B><BR/><FONT POINT-SIZE="9">New, major, minor, fix or automated</FONT> >, URL="./#node-o01", tooltip="Select starting point"];
    O04 [shape=diamond, style="filled", fillcolor="#FFF3CE", color="#AF8300", label="O04  Accept approach?\nScope, priority and dependencies", URL="./#node-o04", tooltip="Accept approach?"];
    O12 [shape=diamond, style="filled", fillcolor="#FFF3CE", color="#AF8300", label="O12  Approve merge?\nHuman reviews the ready PR", URL="./#node-o12", tooltip="Approve merge?"];
  }
  subgraph cluster_chat {
    label="Chat agent"; fontname="DejaVu Sans"; fontsize=14; fontcolor="#3176B8"; color="#3176B8"; fillcolor="#DEEDFF"; style="rounded,filled"; penwidth=1.0; margin=14;
    O02 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O02</FONT><BR/><B>Open workstream</B><BR/><FONT POINT-SIZE="9">Keep a chat per coherent workstream</FONT> >, URL="./#node-o02", tooltip="Open workstream"];
    O03 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O03</FONT><BR/><B>Research and plan</B><BR/><FONT POINT-SIZE="9">Inspect repository, issues and releases</FONT> >, URL="./#node-o03", tooltip="Research and plan"];
    O05 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O05</FONT><BR/><B>Reconcile issues</B><BR/><FONT POINT-SIZE="9">Prepare existing or proposed records</FONT> >, URL="./#node-o05", tooltip="Reconcile issues"];
    O06 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O06</FONT><BR/><B>Select work unit</B><BR/><FONT POINT-SIZE="9">One or several related issues</FONT> >, URL="./#node-o06", tooltip="Select work unit"];
    O07 [shape=diamond, style="filled", fillcolor="#FFF3CE", color="#3176B8", label="O07  Select implementation path\nJules / Codex-Agy / chat admin", URL="./#node-o07", tooltip="Select implementation path"];
    O11 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O11</FONT><BR/><B>Review and correct</B><BR/><FONT POINT-SIZE="9">Diff, CI, issues, metadata, loops</FONT> >, URL="./#node-o11", tooltip="Review and correct"];
    O14 [shape=box, style="rounded,filled", fillcolor="white", color="#3176B8", label=< <FONT POINT-SIZE="9" COLOR="#516273">O14</FONT><BR/><B>Close out and continue</B><BR/><FONT POINT-SIZE="9">Reconcile issues, release and next phase</FONT> >, URL="./#node-o14", tooltip="Close out and continue"];
  }
  subgraph cluster_jules {
    label="Jules"; fontname="DejaVu Sans"; fontsize=14; fontcolor="#39834A"; color="#39834A"; fillcolor="#DDF4DE"; style="rounded,filled"; penwidth=1.0; margin=14;
    O08 [shape=box, style="rounded,filled", fillcolor="white", color="#39834A", label=< <FONT POINT-SIZE="9" COLOR="#516273">O08</FONT><BR/><B>Small coding increment</B><BR/><FONT POINT-SIZE="9">Focused prompt and asynchronous changes</FONT> >, URL="./#node-o08", tooltip="Small coding increment"];
  }
  subgraph cluster_codex {
    label="Codex / Agy"; fontname="DejaVu Sans"; fontsize=14; fontcolor="#8453BA"; color="#8453BA"; fillcolor="#EEE2FF"; style="rounded,filled"; penwidth=1.0; margin=14;
    O09 [shape=box, style="rounded,filled", fillcolor="white", color="#8453BA", label=< <FONT POINT-SIZE="9" COLOR="#516273">O09</FONT><BR/><B>Larger coding increment</B><BR/><FONT POINT-SIZE="9">Interactive or recovery execution</FONT> >, URL="./#node-o09", tooltip="Larger coding increment"];
  }
  subgraph cluster_github {
    label="GitHub / CI"; fontname="DejaVu Sans"; fontsize=14; fontcolor="#8E7474"; color="#8E7474"; fillcolor="#F0EBEB"; style="rounded,filled"; penwidth=1.0; margin=14;
    O10 [shape=box, style="rounded,filled", fillcolor="white", color="#8E7474", label=< <FONT POINT-SIZE="9" COLOR="#516273">O10</FONT><BR/><B>Publish reviewable evidence</B><BR/><FONT POINT-SIZE="9">PR, commits, tests and CI</FONT> >, URL="./#node-o10", tooltip="Publish reviewable evidence"];
    O13 [shape=box, style="rounded,filled", fillcolor="white", color="#8E7474", label=< <FONT POINT-SIZE="9" COLOR="#516273">O13</FONT><BR/><B>Merge / release gate</B><BR/><FONT POINT-SIZE="9">Merge authorised; publish separately</FONT> >, URL="./#node-o13", tooltip="Merge / release gate"];
  }
  O01 -> O02 [];
  O02 -> O03 [];
  O03 -> O04 [];
  O04 -> O03 [label="revise", constraint="false"];
  O04 -> O05 [label="accept"];
  O05 -> O06 [];
  O06 -> O07 [];
  O07 -> O08 [label="Jules"];
  O07 -> O09 [label="Codex/Agy"];
  O07 -> O11 [label="administration only"];
  O08 -> O10 [];
  O09 -> O10 [];
  O10 -> O11 [];
  O11 -> O08 [label="another Jules chunk"];
  O11 -> O09 [label="coding/recovery"];
  O11 -> O12 [label="ready"];
  O12 -> O11 [label="request changes"];
  O12 -> O13 [label="approved"];
  O13 -> O14 [];
  O14 -> O03 [label="next phase", constraint="false"];
}